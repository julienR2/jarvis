{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "knowledge": "off",
    "example-skill": "off",
    "imagerouter": "off",
    "webhook": "off",
    "cron": "off"
  },
  "enabledPlugins": {
    "example-plugin@example-plugin": true
  },
  "extraKnownMarketplaces": {
    "example-plugin": {
      "source": {
        "source": "github",
        "repo": "ayghri/example-plugin"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true
}
