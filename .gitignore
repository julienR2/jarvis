node_modules/
dist/
# pnpm content-addressable store (created at repo root by some installs)
.pnpm-store/
frontend/src/**/*.js
.env
whisper-cache/

# Personal docker-compose overrides (host-specific mounts, networks, etc.)
docker-compose.override.yml

# Personal Claude Code overrides for this repo (permission grants, enabled
# plugins, skill toggles). The committed defaults live in agent/settings.json.
.claude/settings.local.json

# Stray empty DB sometimes created at repo root (real DB lives in agent/data/)
/jarvis.db

# --- Agent config dir (mounted as /jarvis/agent in the container) ---
# Opt-in, not opt-out: everything under agent/ is ignored, and we re-allow only
# what the forkable repo should ship. Runtime state (sessions/, projects/, data/),
# the user's workspace, and personal prefs (CLAUDE.local.md, .example-plugin-always)
# are therefore ignored by default — no need to list them one by one.
# Adding a new default config file? Add a `!agent/<name>` line here.
agent/*
!agent/CLAUDE.md
!agent/mcp.json
!agent/settings.json
!agent/rules/
!agent/skills/

# Whitelist default skills — anything else under agent/skills/ is gitignored
agent/skills/*
!agent/skills/cron/
!agent/skills/webhook/
!agent/skills/apps/
!agent/skills/gmail/
!agent/skills/linear/
!agent/skills/connectors/
!agent/skills/jarvis/
!agent/skills/slack/
!agent/skills/github/
!agent/skills/elevenlabs/
!agent/skills/whisper/
!agent/skills/pocketbase/
!agent/skills/browser/

# Whitelist default rules — anything else under agent/rules/ is gitignored
agent/rules/*
!agent/rules/safety.md
!agent/rules/formatting.md
!agent/rules/emails.md
