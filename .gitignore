node_modules/
dist/
frontend/src/**/*.js
.env
data/
whisper-cache/

# Personal docker-compose overrides (host-specific mounts, networks, etc.)
docker-compose.override.yml

# --- Agent's user workspace (memory, uploads, mini-apps, notes) ---
workspace/

# --- Agent config dir (mounted as /jarvis/agent in the container) ---
# We commit the default skills, rules, CLAUDE.md and settings.json,
# and gitignore everything Claude CLI writes at runtime
# plus any user-added skills.

# Runtime files written by Claude Code CLI
agent/.claude.json
agent/session-env/
agent/sessions/
agent/shell-snapshots/
agent/projects/
agent/plugins/
agent/plans/
agent/backups/
agent/cache/
agent/telemetry/
agent/todos/
agent/debug/
agent/ide/
agent/file-history/

# Personal CLAUDE.md override (Claude Code merges this on top of CLAUDE.md)
agent/CLAUDE.local.md

# Whitelist default skills — anything else under agent/skills/ is gitignored
agent/skills/*
!agent/skills/cron/
!agent/skills/webhook/
!agent/skills/mini-apps/
!agent/skills/gmail/
!agent/skills/pocketbase/
!agent/skills/image-generation/
!agent/skills/linear/
!agent/skills/add-connector/
!agent/skills/self-edit/
!agent/skills/slack/

# Whitelist default rules — anything else under agent/rules/ is gitignored
agent/rules/*
!agent/rules/safety.md
!agent/rules/formatting.md
