# Every variable here is OPTIONAL. A fresh clone runs with no .env at all:
# secrets are auto-generated on first boot, and the Claude OAuth token is
# entered through the setup wizard on first visit.
#
# Copy this file to .env only if you want to pre-seed values — e.g. for a
# headless install or when handing off a pre-configured instance.

# Anthropic OAuth token for the Claude CLI. If unset, the setup wizard asks
# for it on first visit.
# Get one by running `claude setup-token` on any machine with the CLI installed
# (requires a Claude subscription), then paste the sk-ant-oat01-... token it prints.
# Don't copy the token out of ~/.claude/.credentials.json — that one is a
# short-lived access token the CLI refreshes in place, so it dies within hours.
CLAUDE_CODE_OAUTH_TOKEN=

# Secret used to sign JWT tokens. Auto-generated on first boot if unset
# (persisted to agent/data/secrets.json). Set it only to bring your own.
JWT_SECRET=

# Internal API secret — shared between backend and Claude subprocess.
# Auto-generated on first boot if unset.
INTERNAL_SECRET=

# Interface the published ports bind to. Defaults to loopback, so nothing is
# exposed until you deliberately put a reverse proxy in front. Platforms that
# route to the host (rather than over the Docker network) need 0.0.0.0 — put a
# proxy with TLS and auth in front of it if you do that.
BIND_ADDR=127.0.0.1

# Host ports the frontend/backend publish. Change these when running a second
# Jarvis instance on the same machine.
FRONTEND_PORT=5173
BACKEND_PORT=3005

# Timezone for cron scheduler and the agent's sense of "now".
# Defaults to UTC if unset. Examples: Europe/Paris, America/New_York, Asia/Tokyo
TZ=

# Seed an admin user on first boot. If omitted, the UI prompts you to create
# one on first visit — recommended when handing off an instance.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# First-run setup code. The web UI asks for it when creating the first account,
# proving the person claiming the instance has server access. If unset, a code
# is auto-generated and printed in the backend logs at startup
# (docker compose logs backend | grep setup). Set it to pin a known code —
# handy on platforms like Coolify where env vars are easier than logs.
SETUP_CODE=

# Optional headful browser (Settings → Browser), started with:
#   docker compose --profile browser up -d
# Point this at the browser container to enable the proxied page. The backend
# serves it behind your Jarvis login, so it publishes no port of its own.
BROWSER_URL=
# Credentials the proxy uses to answer KasmVNC's own login. Change both together
# with the compose default if you want; you never type them.
BROWSER_USER=jarvis
BROWSER_PASSWORD=jarvis

# Origin that serves generated apps (build-time, read by the frontend).
# Leave empty for a zero-config deploy: apps are served from the same origin as
# the app itself. Apps run with allow-same-origin because they need their own
# localStorage — which on a shared origin also lets an app reach the Jarvis page.
# Point this at a second hostname or port routed to the backend (e.g.
# https://apps.jarvis.example.com) to give apps an origin of their own.
# Read by BOTH the frontend build and the backend (which uses it for the app
# embedded in a shared conversation), so one value covers every place an app
# URL is built. Must be a full origin, e.g. https://apps.jarvis.example.com
VITE_APPS_ORIGIN=

# Reverse-proxy hops to trust when resolving client IPs from X-Forwarded-For
# (rate limiting keys on the client IP). Default: 1, which fits the shipped
# stack (one XFF-writing proxy — nginx/Traefik/Coolify — in front). Set to
# false if clients reach the backend directly, or a number for deeper chains.
TRUST_PROXY=

# Disable Claude CLI telemetry
CLAUDE_TELEMETRY=false

# ─── Skill credentials ──────────────────────────────────────────────────────
# No skill credentials go here — add them from the UI via Connectors.
# They persist in the SQLite DB and are injected into the Claude subprocess
# at runtime, so you can add/remove integrations without restarting.
