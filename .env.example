# Every variable here is OPTIONAL. A fresh clone runs with no .env at all:
# secrets are auto-generated on first boot, and the Claude OAuth token is
# entered through the setup wizard on first visit.
#
# Copy this file to .env only if you want to pre-seed values — e.g. for a
# headless install or when handing off a pre-configured instance.

# Anthropic OAuth token for the Claude CLI. If unset, the setup wizard asks
# for it on first visit.
# Get one by running `claude setup-token` on any machine with the CLI installed
# (requires a Claude subscription), then paste the sk-ant-oat01-... token it prints.
# Don't copy the token out of ~/.claude/.credentials.json — that one is a
# short-lived access token the CLI refreshes in place, so it dies within hours.
CLAUDE_CODE_OAUTH_TOKEN=

# Secret used to sign JWT tokens. Auto-generated on first boot if unset
# (persisted to agent/data/secrets.json). Set it only to bring your own.
JWT_SECRET=

# Internal API secret — shared between backend and Claude subprocess.
# Auto-generated on first boot if unset.
INTERNAL_SECRET=

# Host ports the frontend/backend publish on 127.0.0.1. Change these when
# running a second Jarvis instance on the same machine.
FRONTEND_PORT=5173
BACKEND_PORT=3005

# Timezone for cron scheduler and the agent's sense of "now".
# Defaults to UTC if unset. Examples: Europe/Paris, America/New_York, Asia/Tokyo
TZ=

# Seed an admin user on first boot. If omitted, the UI prompts you to create
# one on first visit — recommended when handing off an instance.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Disable Claude CLI telemetry
CLAUDE_TELEMETRY=false

# ─── Skill credentials ──────────────────────────────────────────────────────
# No skill credentials go here — add them from the UI via Connectors.
# They persist in the SQLite DB and are injected into the Claude subprocess
# at runtime, so you can add/remove integrations without restarting.
